{
  "manifest_version": 3,
  "name": "Badzy",
  "version": "2.1.0",
  "description": "Send downloads and videos from your browser to Badzy: multi-connection speed, resume, video qualities, playlists and magnet links.",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "yt-core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Badzy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "open-badzy": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open Badzy"
    },
    "open-video-panel": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open the video download panel of the page"
    },
    "download-all-links": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Send all links of the page to Badzy"
    },
    "toggle-badzy": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause / resume Badzy"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "badzy@badzy.local",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/NoxEditz/BadzyIDM/releases/latest/download/firefox-updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
