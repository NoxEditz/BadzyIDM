// Badzy – user interface (Slint)
// Badzy 2: top bar with search, animated slide-in menu, category sidebar,
// rounded download list, one progress window per download. Nine themes.

import { ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";
import { Button, LineEdit, SpinBox, ComboBox, Field, Panel, Switch } from "kit.slint";
import { Icons, ToolTip, DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow, CaptionButton, P, G, TypeIcon, BigTypeIcon, ToolBtn, ToolSeparator, TreeItem, HeaderCell, Cell, MenuEntry, MenuSep, MenuLabel, Glyph, HRow, CheckBox } from "common.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { BrowserRow } from "dialogs.slint";
export { ConfirmDialog, ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, TorrentDialog, BrowserDialog, AboutDialog, UpdateDialog, WhatsNewDialog } from "dialogs.slint";

component DownloadItem inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <Cols> cols;
    in property <[ColDef]> columns;
    // how many downloads are selected (the menu then works on all of them)
    in property <int> sel-count;
    // click with Ctrl / Shift
    callback pick(bool, bool);
    // right click: keep a multiple selection that includes this row
    callback right-pick();
    // dragging with the mouse held down: rows below (+) or above (-) this one
    callback drag(int);
    property <int> drag-last;
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    // dragging a finished file out of the program (onto the desktop, a folder…)
    callback drag-out();
    property <bool> dragged-out;
    height: max(38px, 38px * Theme.font-scale);
    // as wide as all the columns (the list then scrolls sideways)
    out property <length> content-w: cells.min-width;
    // wide columns: the row is wider than the list. The look and the mouse
    // cover all of it (in Arabic the name is on the far right side of it)
    Rectangle {
        x: 4px;
        y: 2px;
        width: cells.width - 8px;
        height: parent.height - 4px;
        border-radius: 10px;
        background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 160ms; easing: ease-out; }
        border-width: root.selected ? 1px : 0px;
        border-color: Theme.select-line;
    }
    ta := TouchArea {
        x: 0px;
        width: cells.width;
        height: parent.height;
        double-clicked => {
            root.activated();
        }
        moved => {
            // a finished file pulled sideways: hand it to Windows to drop elsewhere
            if (self.pressed && root.done && !root.dragged-out && abs(self.mouse-x - self.pressed-x) > 12px) {
                root.dragged-out = true;
                root.drag-out();
                return;
            }
            if (self.pressed && floor(self.mouse-y / root.height) != root.drag-last) {
                root.drag-last = floor(self.mouse-y / root.height);
                root.drag(root.drag-last);
            }
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.drag-last = 0;
                root.dragged-out = false;
                root.pick(ev.modifiers.control, ev.modifiers.shift);
            }
            // right click: select the row and open the menu where the mouse is
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.right-pick();
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    property <bool> done: root.data.state == 3;
    property <bool> can-resume: root.data.state == 2 || root.data.state == 4;
    property <bool> can-stop: root.data.state == 0 || root.data.state == 1;
    menu := PopupWindow {
        // Arabic: the menu opens to the left of the mouse
        x: Theme.rtl ? max(0px, root.menu-x - 260px) : root.menu-x;
        y: root.menu-y;
        width: 260px;
        height: menu-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: menu-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 3px;
            menu-list := VerticalLayout {
                padding: 4px;
                spacing: 0px;
                if root.sel-count > 1: MenuLabel {
                    text: @tr("{} downloads selected", root.sel-count);
                }
                MenuEntry {
                    text: root.done ? @tr("Open") : @tr("Show download progress");
                    glyph: root.done ? "play" : "progress";
                    bold: true;
                    clicked => {
                        root.activated();
                    }
                }
                MenuEntry {
                    text: @tr("Open with…");
                    glyph: "openwith";
                    enabled: root.done;
                    clicked => {
                        root.action("openwith");
                    }
                }
                if !root.done && (root.data.kind == "video" || root.data.kind == "audio"): MenuEntry {
                    text: @tr("Play while downloading");
                    glyph: "play";
                    glyph-color: #d6631d;
                    clicked => {
                        root.action("preview");
                    }
                }
                MenuEntry {
                    text: @tr("Open folder");
                    glyph: "folder";
                    clicked => {
                        root.action("folder");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Resume download");
                    glyph: "play";
                    glyph-color: #2e9e4f;
                    enabled: root.can-resume || root.sel-count > 1;
                    clicked => {
                        root.action("resume");
                    }
                }
                MenuEntry {
                    text: @tr("Stop download");
                    glyph: "pause";
                    glyph-color: #e08a00;
                    enabled: root.can-stop || root.sel-count > 1;
                    clicked => {
                        root.action("stop");
                    }
                }
                MenuEntry {
                    text: @tr("Redownload");
                    glyph: "redo";
                    clicked => {
                        root.action("restart");
                    }
                }
                MenuEntry {
                    text: @tr("Refresh download address…");
                    glyph: "refresh";
                    enabled: !root.done;
                    clicked => {
                        root.action("refresh");
                    }
                }
                MenuEntry {
                    text: @tr("Move / Rename…");
                    glyph: "edit";
                    clicked => {
                        root.action("move");
                    }
                }
                MenuSep { }
                MenuLabel {
                    text: @tr("Move to queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: root.data.queue == q.id ? "check" : "";
                    indent: true;
                    clicked => {
                        root.move-to-queue(q.id);
                    }
                }
                MenuEntry {
                    text: @tr("Delete from queue");
                    indent: true;
                    enabled: root.data.queue != "";
                    clicked => {
                        root.move-to-queue(-1);
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Copy address");
                    glyph: "copy";
                    clicked => {
                        root.action("copy");
                    }
                }
                MenuEntry {
                    text: @tr("Check file (SHA-256)");
                    glyph: "hash";
                    enabled: root.done;
                    clicked => {
                        root.action("sha256");
                    }
                }
                MenuEntry {
                    text: @tr("Properties");
                    glyph: "info";
                    clicked => {
                        root.action("properties");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Remove");
                    glyph: "close";
                    glyph-color: #e0443b;
                    clicked => {
                        root.action("delete");
                    }
                }
            }
        }
    }
    cells := HRow {
        padding-left: Theme.rtl ? (0px) : (6px);
        padding-right: Theme.rtl ? (6px) : (0px);
        spacing: 0px;
        Rectangle {
            width: 32px;
            TypeIcon {
                kind: root.data.kind;
                x: 4px;
                y: (parent.height - 18px) / 2;
            }
        }
        // the columns in the order and widths of the header
        for c in root.columns: Rectangle {
            width: c.width;
            visible: c.width > 0px;
            // clip: long right-to-left (Arabic) names must never spill over
            clip: true;
            if c.key == "name": Cell {
                x: Theme.rtl ? 4px : 0px;
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.name;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            if c.key == "q": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.queue;
                horizontal-alignment: center;
                color: Theme.accent;
            }
            if c.key == "size": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.size;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "status": Rectangle {
                // thin progress line under the status, for running downloads
                if root.data.state == 1 || (root.data.state == 2 && root.data.progress > 0): Rectangle {
                    x: 10px;
                    y: parent.height - 11px;
                    width: parent.width - 20px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.bar-bg;
                    Rectangle {
                        x: Theme.rtl ? parent.width - self.width : 0;
                        width: parent.width * root.data.progress;
                        height: parent.height;
                        border-radius: 2.5px;
                        clip: true;
                        background: root.data.state == 1 ? @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%) : @linear-gradient(90deg, Theme.warn 0%, Theme.warn 100%);
                        animate width {
                            duration: 300ms;
                            easing: ease-out;
                        }
                        // a light that runs along a download that is going
                        if root.data.state == 1: Rectangle {
                            width: 40px;
                            height: parent.height;
                            x: (parent.width + 40px) * Math.mod(animation-tick() / 1.4s, 1.0) - 40px;
                            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff77 50%, #ffffff00 100%);
                        }
                    }
                }
                Cell {
                    width: parent.width;
                    height: parent.height - 2px;
                    text: root.data.status;
                    horizontal-alignment: center;
                    color: root.data.state == 3 ? Theme.ok : root.data.state == 4 ? Theme.err : root.data.state == 1 ? Theme.accent : Theme.text;
                }
            }
            if c.key == "eta": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.eta;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "speed": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.speed;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "last": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.last-try;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "desc": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.description;
                color: Theme.muted;
            }
            if c.key == "added": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.added;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "saveto": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.save-to;
                color: Theme.muted;
            }
            if c.key == "referer": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.referer;
                color: Theme.muted;
            }
            if c.key == "parent": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.parent;
                color: Theme.muted;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// right click menu of the sidebar (categories and queues)
component TreeMenu inherits PopupWindow {
    in property <string> target;
    in property <bool> is-queue;
    in property <bool> builtin;
    callback chosen(string);
    width: 210px;
    height: tm-list.preferred-height;
    Rectangle {
        width: parent.width;
        height: tm-list.preferred-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 3px;
        tm-list := VerticalLayout {
            padding: 4px;
            if root.is-queue: MenuEntry {
                text: @tr("Start queue");
                glyph: "play";
                glyph-color: #2e9e4f;
                clicked => {
                    root.chosen("start");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Stop queue");
                glyph: "stop";
                glyph-color: #e0443b;
                clicked => {
                    root.chosen("stop");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Edit queue / schedule…");
                glyph: "clock";
                clicked => {
                    root.chosen("edit");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("New queue…");
                glyph: "plus";
                clicked => {
                    root.chosen("new");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Delete queue");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue: MenuEntry {
                text: @tr("Add category…");
                glyph: "plus";
                clicked => {
                    root.chosen("add");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Delete category");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Properties…");
                glyph: "info";
                clicked => {
                    root.chosen("props");
                }
            }
        }
    }
}

// a sidebar item with its own right click menu
component CtxTreeItem inherits TreeItem {
    in property <bool> is-queue;
    in property <bool> builtin;
    in property <string> target;
    callback chosen(string);
    property <length> mx;
    property <length> my;
    context(x, y) => {
        self.mx = x;
        self.my = y;
        pm.show();
    }
    pm := TreeMenu {
        x: Theme.rtl ? max(0px, root.mx - 210px) : root.mx;
        y: root.my;
        target: root.target;
        is-queue: root.is-queue;
        builtin: root.builtin;
        chosen(a) => {
            root.chosen(a);
        }
    }
}

// an entry of the left navigation
component NavItem inherits Rectangle {
    in property <image> icon;
    in property <bool> narrow;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 44px;
    border-radius: 12px;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent;
    transform-scale: ta.pressed ? 0.97 : 1.0;
    animate background { duration: 160ms; easing: ease-out; }
    animate transform-scale { duration: 120ms; easing: ease-out; }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HRow {
        padding-left: root.narrow ? 0px : 14px;
        padding-right: root.narrow ? 0px : 14px;
        spacing: root.narrow ? 0px : 12px;
        Rectangle {
            preferred-width: 20px;
            min-width: 20px;
            horizontal-stretch: root.narrow ? 1 : 0;
            Image {
                x: (parent.width - 20px) / 2;
                y: (parent.height - 20px) / 2;
                width: 20px;
                height: 20px;
                source: root.icon;
                colorize: root.selected ? Theme.accent : Theme.muted;
                animate colorize { duration: 160ms; }
            }
        }
        if !root.narrow: Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: 14px * Theme.font-scale;
            font-weight: root.selected ? 700 : 500;
        }
    }
}

// a category tile above the list
component Chip inherits Rectangle {
    in property <string> kind;
    in property <string> text;
    in property <bool> selected;
    in property <bool> all;
    callback clicked();
    width: 88px;
    height: 70px;
    border-radius: 14px;
    background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : Theme.panel.transparentize(0.2);
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Theme.accent : Theme.line;
    transform-scale: ta.pressed ? 0.95 : ta.has-hover ? 1.04 : 1.0;
    animate background { duration: 160ms; easing: ease-out; }
    animate border-color { duration: 160ms; easing: ease-out; }
    animate transform-scale { duration: 130ms; easing: ease-out; }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 4px;
        padding-right: 4px;
        Rectangle {
            height: 26px;
            if root.all: Image {
                source: @image-url("icons/apps.svg");
                colorize: root.selected ? Theme.accent : Theme.muted;
                x: (parent.width - 24px) / 2;
                y: 1px;
                width: 24px;
                height: 24px;
            }
            if !root.all: TypeIcon {
                kind: root.kind;
                x: (parent.width - 26px) / 2;
                width: 26px;
                height: 26px;
            }
        }
        Text {
            text: root.text;
            horizontal-alignment: center;
            overflow: elide;
            font-size: 11px * Theme.font-scale;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.text : Theme.muted;
        }
    }
}

// a round button in the top bar
component TopBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> dot;
    callback clicked();
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background: ta.pressed ? Theme.select : ta.has-hover ? Theme.toolbar-hover : Theme.input-bg.transparentize(0.35);
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.line;
    transform-scale: ta.pressed ? 0.92 : ta.has-hover ? 1.06 : 1.0;
    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }
    animate transform-scale { duration: 130ms; easing: ease-out; }
    Image {
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: Theme.toolbar-text;
    }
    if root.dot: Rectangle {
        x: parent.width - 15px;
        y: 8px;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.window;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// a card of the right panel
component Card inherits Rectangle {
    background: Theme.panel.transparentize(0.12);
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.line;
}

// one entry of the slide-in menu
component DrawerItem inherits MenuEntry {
    height: 34px;
    border-radius: 10px;
}

// the title of a group of entries
component DrawerHead inherits Rectangle {
    in property <string> text;
    height: 34px;
    Text {
        x: Theme.rtl ? 0px : 10px;
        width: parent.width - 10px;
        y: 12px;
        text: root.text;
        font-size: 11px * Theme.font-scale;
        font-weight: 800;
        color: Theme.accent;
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    }
}

export component MainWindow inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Badzy");
    // Options > General > Background picture (shows through the panels)
    in property <image> bg-image;
    in property <bool> has-bg-image;
    // the size the window opens with
    preferred-width: 1120px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 440px;
    // its own rounded title bar (the Windows frame is not drawn)
    no-frame: true;
    in-out property <bool> is-max;
    callback win-drag();
    callback win-min();
    callback win-max();
    callback win-close();
    // which edge is dragged: 0 N, 1 S, 2 E, 3 W, 4 NE, 5 NW, 6 SE, 7 SW
    callback win-resize(int);

    in property <[DownloadRow]> rows;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    // counts: all, unfinished, finished
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    // "all", "cat:Video", "unfinished", "unf:Video", "finished", "fin:Video", "queue:3"
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    // multiple selection: how many, and whether any can be resumed / stopped
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    // Downloads > When all downloads finish: 0 nothing, 1 shut down, 2 sleep, 3 exit, 4 hibernate
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;
    // the slide-in menu (opened with the button in the top bar)
    // a new version is on GitHub: the bell in the top bar shows a dot
    in property <bool> update-available: false;
    // disk of the download folder (right panel); empty = card hidden
    in property <string> disk-used;
    in property <string> disk-free;
    in property <float> disk-frac;
    in-out property <bool> drawer-open: false;
    // the downloads that are running now (shown in the side card)
    in property <[DownloadRow]> active-rows;
    // the list tells Rust how wide it is, Rust answers with the columns that fit
    callback list-resized(length);
    // window size classes: the layout adapts instead of cutting things off
    // (measured by a probe below: reading root.width inside the layout would loop)
    in-out property <length> win-w: 1120px;
    out property <bool> compact: root.win-w < 1000px;
    out property <bool> show-side: root.win-w >= 1120px;
    out property <length> nav-w: root.win-w < 920px ? 64px : root.win-w < 1200px ? 176px : 196px;
    property <float> drawer-t: root.drawer-open ? 1.0 : 0.0;
    animate drawer-t { duration: 280ms; easing: ease-out; }
    // 0 -> 1 when the window opens: the parts fade in one after another
    property <float> intro: 0.0;
    animate intro { duration: 650ms; easing: ease-out; }

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    // the list's columns (order + widths); dragging in the header changes them
    in property <[ColDef]> columns;
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    pure function col-title(k: string) -> string {
        if (k == "name") { return @tr("File Name"); }
        if (k == "q") { return @tr("Q"); }
        if (k == "size") { return @tr("Size"); }
        if (k == "status") { return @tr("Status"); }
        if (k == "eta") { return @tr("Time left"); }
        if (k == "speed") { return @tr("Transfer rate"); }
        if (k == "last") { return @tr("Last Try Date"); }
        if (k == "desc") { return @tr("Description"); }
        if (k == "added") { return @tr("Date Added"); }
        if (k == "saveto") { return @tr("Save To"); }
        if (k == "referer") { return @tr("Referer"); }
        if (k == "parent") { return @tr("Parent Web Page"); }
        return k;
    }
    pure function col-sort-key(k: string) -> string {
        if (k == "q") { return ""; }
        if (k == "last") { return "date"; }
        return k;
    }
    callback select-all();
    callback row-action(int, string);
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback torrent();
    callback browsers();
    callback tips();
    callback about();
    callback quit();

    function category-menu(target: string, a: string) {
        if (a == "add") {
            root.add-category();
        } else if (a == "delete") {
            root.delete-category(target);
        } else if (a == "props") {
            root.category-props(target);
        }
    }
    function queue-menu-action(q: int, a: string) {
        if (a == "start") {
            root.start-queue(q);
        } else if (a == "stop") {
            root.stop-queue(q);
        } else if (a == "edit") {
            root.edit-queue(q);
        } else if (a == "new") {
            root.new-queue();
        } else if (a == "delete") {
            root.delete-queue(q);
        }
    }

    property <length> qmenu-x;
    property <bool> qmenu-start: true;
    queue-menu := PopupWindow {
        x: Theme.rtl ? max(0px, root.qmenu-x + 62px - 220px) : root.qmenu-x;
        y: 66px;
        width: 220px;
        height: qm-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: qm-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            qm-list := VerticalLayout {
                padding: 4px;
                MenuLabel {
                    text: root.qmenu-start ? @tr("Start queue") : @tr("Stop queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: q.running ? "play" : "";
                    glyph-color: #2e9e4f;
                    indent: true;
                    clicked => {
                        if (root.qmenu-start) {
                            root.start-queue(q.id);
                        } else {
                            root.stop-queue(q.id);
                        }
                    }
                }
            }
        }
    }

    if root.has-bg-image: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.bg-image;
        image-fit: cover;
    }
    if Theme.dark: Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: @image-url("art/window-bg.jpg");
        image-fit: cover;
        opacity: 0.5 * root.intro;
    }
    if Theme.dark: Image {
        width: min(560px, root.width * 0.42);
        height: self.width * 0.5333;
        x: root.width - self.width;
        y: 0px;
        source: @image-url("art/corner-tr.png");
        opacity: 0.75 * root.intro;
    }
    if Theme.dark: Image {
        width: min(560px, root.width * 0.42);
        height: self.width * 0.5333;
        x: 0px;
        y: root.height - self.height;
        source: @image-url("art/corner-bl.png");
        opacity: 0.7 * root.intro;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && root.drawer-open) {
                root.drawer-open = false;
                return accept;
            }
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.select-all();
                return accept;
            }
            if (event.text == Key.Delete && root.selected-id >= 0) {
                root.delete(root.selected-id);
                return accept;
            }
            if (event.text == Key.Return && root.selected-id >= 0) {
                root.row-activated(root.selected-id);
                return accept;
            }
            if (event.text == Key.F3) {
                root.find-next();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                root.find();
                return accept;
            }
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.add-url();
                return accept;
            }
            if (event.modifiers.control && (event.text == "b" || event.text == "B")) {
                root.add-batch();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // ---- title strip: drag here, window buttons
            Rectangle {
                height: 34px;
                background: Theme.window;
                Rectangle {
                    width: parent.width;
                    height: 3px;
                    y: 0px;
                    background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 50%, Theme.accent 100%);
                }
                HRow {
                    padding-top: 3px;
                    spacing: 0px;
                    Rectangle {
                        horizontal-stretch: 1;
                        TouchArea {
                            pointer-event(ev) => {
                                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                    root.win-drag();
                                }
                            }
                            double-clicked => {
                                root.win-max();
                            }
                        }
                        HRow {
                            padding-left: Theme.rtl ? 0px : 14px;
                            padding-right: Theme.rtl ? 14px : 0px;
                            spacing: 8px;
                            Rectangle {
                                width: 16px;
                                Image {
                                    y: (parent.height - 16px) / 2;
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("icon-window.png");
                                }
                            }
                            Text {
                                text: @tr("Badzy");
                                vertical-alignment: center;
                                font-size: 12px * Theme.font-scale;
                                font-weight: 700;
                                color: Theme.muted;
                                horizontal-stretch: 1;
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            }
                        }
                    }
                    CaptionButton {
                        kind: "min";
                        clicked => {
                            root.win-min();
                        }
                    }
                    CaptionButton {
                        kind: root.is-max ? "restore" : "max";
                        clicked => {
                            root.win-max();
                        }
                    }
                    CaptionButton {
                        kind: "close";
                        clicked => {
                            root.win-close();
                        }
                    }
                }
            }
            // ---- top bar: menu, logo, search
            Rectangle {
                height: 72px;
                background: Theme.toolbar-top.transparentize(0.25);
                opacity: root.intro;
                // the menu button: three bars that glide into a cross
                menu-btn := Rectangle {
                    x: Theme.rtl ? parent.width - self.width - 12px : 12px;
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 40px;
                    border-radius: 12px;
                    background: mb.pressed ? Theme.select : mb.has-hover ? Theme.toolbar-hover : transparent;
                    transform-scale: mb.pressed ? 0.92 : mb.has-hover ? 1.06 : 1.0;
                    animate background { duration: 150ms; easing: ease-out; }
                    animate transform-scale { duration: 140ms; easing: ease-out; }
                    Rectangle {
                        x: 11px;
                        y: 13px + 6px * root.drawer-t;
                        width: 18px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.toolbar-text;
                        transform-rotation: 45deg * root.drawer-t;
                    }
                    Rectangle {
                        x: 11px;
                        y: 19px;
                        width: 18px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.toolbar-text;
                        opacity: 1.0 - root.drawer-t;
                    }
                    Rectangle {
                        x: 11px;
                        y: 25px - 6px * root.drawer-t;
                        width: 18px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.toolbar-text;
                        transform-rotation: -45deg * root.drawer-t;
                    }
                    mb := TouchArea {
                        clicked => {
                            root.drawer-open = !root.drawer-open;
                        }
                    }
                }
                // logo + name
                Image {
                    x: Theme.rtl ? parent.width - 12px - 40px - 10px - self.width : 62px;
                    y: (parent.height - self.height) / 2;
                    width: 30px;
                    height: 30px;
                    source: @image-url("icon.png");
                    image-fit: contain;
                    opacity: 0.6 + 0.4 * root.intro;
                }
                Image {
                    x: Theme.rtl ? parent.width - 12px - 40px - 10px - 30px - 8px - self.width : 100px;
                    y: (parent.height - self.height) / 2;
                    width: 108px;
                    height: 31px;
                    source: @image-url("art/wordmark.png");
                    image-fit: contain;
                }
                // search
                Rectangle {
                    width: min(340px, max(140px, (parent.width - 260px) * 0.9));
                    height: 38px;
                    x: Theme.rtl ? 120px : parent.width - self.width - 124px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 19px;
                    background: Theme.input-bg;
                    border-width: 1px;
                    border-color: ti.has-focus ? Theme.accent : Theme.line;
                    animate border-color { duration: 160ms; easing: ease-out; }
                    // a small magnifier
                    Rectangle {
                        x: Theme.rtl ? parent.width - 28px : 15px;
                        y: 11px;
                        width: 11px;
                        height: 11px;
                        border-radius: 5.5px;
                        border-width: 2px;
                        border-color: ti.has-focus ? Theme.accent : Theme.muted;
                    }
                    Rectangle {
                        x: Theme.rtl ? parent.width - 33px : 24px;
                        y: 24px;
                        width: 6px;
                        height: 2px;
                        border-radius: 1px;
                        background: ti.has-focus ? Theme.accent : Theme.muted;
                        transform-rotation: Theme.rtl ? -45deg : 45deg;
                    }
                    ti := TextInput {
                        x: 38px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 38px - 38px;
                        color: Theme.text;
                        font-size: 13px * Theme.font-scale;
                        single-line: true;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text <=> root.search;
                        edited => {
                            root.search-changed();
                        }
                    }
                    if ti.text == "": Text {
                        x: 38px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 76px;
                        text: @tr("Filter the list…");
                        font-size: 13px * Theme.font-scale;
                        color: Theme.muted;
                        overflow: elide;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    }
                    if ti.text != "": Rectangle {
                        x: Theme.rtl ? 8px : parent.width - 30px;
                        y: 8px;
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: cx.has-hover ? Theme.select : transparent;
                        animate background { duration: 120ms; }
                        Text {
                            text: "✕";
                            font-size: 10px;
                            color: Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cx := TouchArea {
                            clicked => {
                                root.search = "";
                                root.search-changed();
                            }
                        }
                    }
                }
                TopBtn {
                    x: Theme.rtl ? 66px : parent.width - 108px;
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/bell.svg");
                    dot: root.update-available;
                    clicked => {
                        root.check-app-update();
                    }
                }
                TopBtn {
                    x: Theme.rtl ? 16px : parent.width - 58px;
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/settings.svg");
                    clicked => {
                        root.open-settings(0);
                    }
                }
                // a thin line in the colours of the theme
                Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
                    opacity: 0.85 * root.intro;
                }
            }
            HRow {
                vertical-stretch: 1;
                padding: 12px;
                spacing: 12px;
                // ---- left navigation
                Rectangle {
                    width: root.nav-w;
                    animate width { duration: 200ms; easing: ease-out; }
                    clip: true;
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 2px;
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/home.svg");
                            text: @tr("All Downloads");
                            selected: root.view == "all";
                            clicked => {
                                root.view = "all";
                                root.view-changed(root.view);
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/download.svg");
                            text: @tr("Unfinished");
                            selected: root.view == "unfinished";
                            clicked => {
                                root.view = "unfinished";
                                root.view-changed(root.view);
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/check.svg");
                            text: @tr("Finished");
                            selected: root.view == "finished";
                            clicked => {
                                root.view = "finished";
                                root.view-changed(root.view);
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/clock.svg");
                            text: @tr("Scheduler");
                            clicked => {
                                root.open-scheduler();
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/globe.svg");
                            text: @tr("Grabber");
                            clicked => {
                                root.grabber();
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/list.svg");
                            text: @tr("Playlist");
                            clicked => {
                                root.playlist();
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/magnet.svg");
                            text: @tr("Torrent");
                            clicked => {
                                root.torrent();
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/external-link.svg");
                            text: @tr("Add Badzy to my browser…");
                            clicked => {
                                root.browsers();
                            }
                        }
                        NavItem {
                            narrow: root.nav-w < 100px;
                            icon: @image-url("icons/settings.svg");
                            text: @tr("Options");
                            clicked => {
                                root.open-settings(0);
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            if root.nav-w > 100px: Image {
                                x: 0px;
                                y: parent.height - self.height - 52px;
                                width: parent.width;
                                height: min(parent.height - 52px, parent.width * 0.83);
                                source: @image-url("art/sidebar-art.png");
                                image-fit: cover;
                                image-rendering: smooth;
                                opacity: 0.9 * root.intro;
                            }
                            if root.nav-w > 100px: Image {
                                x: 10px;
                                y: parent.height - self.height - 2px;
                                width: parent.width - 20px;
                                height: 48px;
                                source: @image-url("art/tagline.png");
                                image-fit: contain;
                                horizontal-alignment: left;
                            }
                        }
                    }
                }
                // ---- centre
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    // ---- category tiles
                    Flickable {
                        height: 74px;
                        content-width: chips.preferred-width;
                        chips := HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Chip {
                                all: true;
                                text: @tr("All");
                                selected: root.view == "all";
                                clicked => {
                                    root.view = "all";
                                    root.view-changed(root.view);
                                }
                            }
                            for c in root.categories: Chip {
                                kind: c.kind;
                                text: c.label;
                                selected: root.view == "cat:" + c.name;
                                clicked => {
                                    root.view = "cat:" + c.name;
                                    root.view-changed(root.view);
                                }
                            }
                        }
                    }
            // ---- toolbar (buttons that don't fit a narrow window are cut off)
            Rectangle {
                height: 54px;
                min-width: 0px;
                clip: true;
                background: Theme.panel.transparentize(0.12);
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.line;
                opacity: root.intro;
                HRow {
                    padding: 8px;
                    padding-left: Theme.rtl ? (10px) : (8px);
                    padding-right: Theme.rtl ? (8px) : (10px);
                    spacing: 3px;
                    ToolBtn {
                        icon: "add";
                        text: @tr("Add URL");
                        small: true;
                        look: "primary";
                        clicked => {
                            root.add-url();
                        }
                    }
                    ToolBtn {
                        icon: "batch";
                        text: @tr("Add Batch");
                        small: true;
                        look: root.win-w < 1180px ? "icon" : "labeled";
                        clicked => {
                            root.add-batch();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "resume";
                        text: @tr("Resume");
                        small: true;
                        enabled: root.can-resume;
                        clicked => {
                            root.resume(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "stop";
                        text: @tr("Stop");
                        small: true;
                        enabled: root.can-stop;
                        clicked => {
                            root.pause(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "stopall";
                        text: @tr("Stop All");
                        small: true;
                        clicked => {
                            root.stop-all();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "delete";
                        text: @tr("Delete");
                        small: true;
                        enabled: root.selected-id >= 0;
                        clicked => {
                            root.delete(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "deletedone";
                        text: @tr("Delete Done");
                        small: true;
                        clicked => {
                            root.delete-completed();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "limiter";
                        text: root.limiter-on ? @tr("Limiter: On") : @tr("Limiter: Off");
                        small: true;
                        look: root.win-w < 1180px ? "icon" : "labeled";
                        clicked => {
                            root.toggle-limiter();
                        }
                    }
                    ToolSeparator { }
                    start-q := ToolBtn {
                        icon: "startqueue";
                        text: @tr("Start Queue");
                        small: true;
                        look: root.win-w < 1180px ? "icon" : "labeled";
                        clicked => {
                            root.qmenu-start = true;
                            root.qmenu-x = self.x;
                            queue-menu.show();
                        }
                    }
                    stop-q := ToolBtn {
                        icon: "stopqueue";
                        text: @tr("Stop Queue");
                        small: true;
                        look: root.win-w < 1180px ? "icon" : "labeled";
                        clicked => {
                            root.qmenu-start = false;
                            root.qmenu-x = self.x;
                            queue-menu.show();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }
            }

                    VerticalLayout {
                        vertical-stretch: 1;
                // ---- list (columns that don't fit are cut off on the right)
                Rectangle {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    background: Theme.panel.transparentize(0.12);
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Theme.line;
                    opacity: root.intro;
                    transform-scale: 0.98 + 0.02 * root.intro;
                    init => {
                        root.list-resized(self.width);
                    }
                    changed width => {
                        root.list-resized(self.width);
                    }
                    VerticalLayout {
                        padding: 1px;
                        Rectangle {
                            height: 34px;
                            background: Theme.header-top;
                            clip: true;
                            // scrolls sideways together with the list (wide columns)
                            hdr := HRow {
                                x: lv.viewport-x;
                                width: max(parent.width, lv.viewport-width);
                                padding-left: Theme.rtl ? (0px) : (6px);
                                padding-right: Theme.rtl ? (6px) : (0px);
                                HeaderCell {
                                    text: "";
                                    width: 32px;
                                }
                                for c[i] in root.columns: HeaderCell {
                                    width: c.width;
                                    visible: c.width > 0px;
                                    adjustable: c.key != "name";
                                    text: root.col-title(c.key);
                                    key: root.col-sort-key(c.key);
                                    align: c.key == "size" || c.key == "eta" || c.key == "speed" ? TextHorizontalAlignment.right : c.key == "q" || c.key == "status" || c.key == "last" || c.key == "added" ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                    resized(w) => {
                                        root.column-resized(i, w);
                                    }
                                    resize-done => {
                                        root.columns-changed();
                                    }
                                    dropped(x) => {
                                        // measured from the side where the columns start
                                        root.column-dropped(i, Theme.rtl ? hdr.width - x : x);
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Rectangle {
                                x: 0;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: Theme.line;
                            }
                        }
                        lv := ListView {
                            vertical-stretch: 1;
                            // Arabic: wide columns start at the right edge, so
                            // the list first shows its right side
                            property <length> rtl-start: Theme.rtl ? min(0px, self.visible-width - self.viewport-width) : 0px;
                            changed rtl-start => {
                                self.viewport-x = self.rtl-start;
                            }
                            init => {
                                self.viewport-x = self.rtl-start;
                            }
                            for r in root.rows: DownloadItem {
                                // every row as wide as its columns: the mouse and
                                // the highlight reach the name in Arabic too
                                width: max(lv.visible-width, self.content-w);
                                data: r;
                                queues: root.queues;
                                cols: root.cols;
                                columns: root.columns;
                                selected: r.sel;
                                sel-count: root.sel-count;
                                pick(ctrl, shift) => {
                                    root.row-clicked(r.id, ctrl, shift);
                                    keys.focus();
                                }
                                right-pick => {
                                    root.row-right(r.id);
                                }
                                drag(offset) => {
                                    root.row-drag(r.id, offset);
                                }
                                drag-out => {
                                    root.row-drag-out(r.id);
                                }
                                activated => {
                                    root.row-activated(r.id);
                                }
                                action(a) => {
                                    root.row-action(r.id, a);
                                }
                                move-to-queue(q) => {
                                    root.row-to-queue(r.id, q);
                                }
                            }
                        }
                    }
                    if root.rows.length == 0: Text {
                        x: 0;
                        y: 120px;
                        width: parent.width;
                        text: root.search != "" ? @tr("Nothing matches “{}”.", root.search) : @tr("No downloads here.\nClick “Add URL”, copy a link, or download something in your browser.");
                        horizontal-alignment: center;
                        color: Theme.muted;
                    }
                }
                    }
                }
                // ---- right panel
                if root.show-side: VerticalLayout {
                    width: root.win-w < 1300px ? 260px : 300px;
                    spacing: 12px;
                // ---- tree
                if !root.hide-categories: Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel.transparentize(0.12);
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Theme.line;
                    opacity: root.intro;
                    transform-scale: 0.97 + 0.03 * root.intro;
                    VerticalLayout {
                        padding: 2px;
                        Rectangle {
                            height: 23px;
                            background: Theme.window;
                            Text {
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                x: 6px;
                                width: parent.width - 12px;
                                height: parent.height;
                                text: @tr("Categories");
                                vertical-alignment: center;
                                font-size: 12px * Theme.font-scale;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                CtxTreeItem {
                                    text: @tr("All Downloads");
                                    icon: "folder";
                                    bold: true;
                                    expandable: true;
                                    expanded: root.open-all;
                                    count: root.count-all;
                                    selected: root.view == "all";
                                    clicked => {
                                        root.view = "all";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-all = !root.open-all;
                                    }
                                    builtin: true;
                                    chosen(a) => {
                                        root.category-menu("", a);
                                    }
                                }
                                if root.open-all: VerticalLayout {
                                    for c in root.categories: CtxTreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.count;
                                        target: c.name;
                                        builtin: c.builtin;
                                        selected: root.view == "cat:" + c.name;
                                        clicked => {
                                            root.view = "cat:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                        chosen(a) => {
                                            root.category-menu(c.name, a);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Unfinished");
                                    icon: "unfinished";
                                    expandable: true;
                                    expanded: root.open-unf;
                                    count: root.count-unfinished;
                                    selected: root.view == "unfinished";
                                    clicked => {
                                        root.view = "unfinished";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-unf = !root.open-unf;
                                    }
                                }
                                if root.open-unf: VerticalLayout {
                                    for c in root.categories: TreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.unfinished;
                                        selected: root.view == "unf:" + c.name;
                                        clicked => {
                                            root.view = "unf:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Finished");
                                    icon: "finished";
                                    expandable: true;
                                    expanded: root.open-fin;
                                    count: root.count-finished;
                                    selected: root.view == "finished";
                                    clicked => {
                                        root.view = "finished";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-fin = !root.open-fin;
                                    }
                                }
                                if root.open-fin: VerticalLayout {
                                    for c in root.categories: TreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.finished;
                                        selected: root.view == "fin:" + c.name;
                                        clicked => {
                                            root.view = "fin:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Queues");
                                    icon: "folder";
                                    bold: true;
                                    expandable: true;
                                    expanded: root.open-queues;
                                    toggle => {
                                        root.open-queues = !root.open-queues;
                                    }
                                    clicked => {
                                        root.open-queues = !root.open-queues;
                                    }
                                }
                                if root.open-queues: VerticalLayout {
                                    for q in root.queues: CtxTreeItem {
                                        is-queue: true;
                                        builtin: q.id == 1;
                                        target: q.name;
                                        text: q.running ? @tr("{} (running)", q.name) : q.name;
                                        icon: "queue";
                                        indent: 1;
                                        count: q.count > 0 ? q.count : "";
                                        selected: root.view == "queue:" + q.id;
                                        clicked => {
                                            root.view = "queue:" + q.id;
                                            root.view-changed(root.view);
                                        }
                                        toggle => {
                                            root.edit-queue(q.id);
                                        }
                                        chosen(a) => {
                                            root.queue-menu-action(q.id, a);
                                        }
                                    }
                                }
                            }
                        }
                        HRow {
                            padding: 4px;
                            spacing: 4px;
                            Button {
                                text: @tr("New queue");
                                horizontal-stretch: 1;
                                clicked => {
                                    root.new-queue();
                                }
                            }
                            Button {
                                text: @tr("Edit");
                                clicked => {
                                    root.edit-queue(root.current-queue);
                                }
                            }
                        }
                    }
                }

                    // ---- active downloads
                    Card {
                        height: act.preferred-height;
                        act := VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HRow {
                                spacing: 8px;
                                Image {
                                    width: 18px;
                                    height: 18px;
                                    source: @image-url("icons/lightning.svg");
                                    colorize: Theme.accent;
                                }
                                Text {
                                    text: @tr("Active downloads");
                                    font-size: 14px * Theme.font-scale;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                            }
                            for r in root.active-rows: Rectangle {
                                height: 50px;
                                clip: true;
                                Text {
                                    x: 0px;
                                    y: 2px;
                                    width: parent.width - 40px;
                                    text: r.name;
                                    overflow: elide;
                                    font-size: 12px * Theme.font-scale;
                                    font-weight: 600;
                                    color: Theme.text;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                                Rectangle {
                                    x: 0px;
                                    y: 24px;
                                    width: parent.width - 40px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.bar-bg;
                                    Rectangle {
                                        x: Theme.rtl ? parent.width - self.width : 0px;
                                        width: parent.width * r.progress;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
                                        animate width { duration: 300ms; easing: ease-out; }
                                    }
                                }
                                Text {
                                    x: 0px;
                                    y: 34px;
                                    width: parent.width - 40px;
                                    text: r.speed + "   " + r.eta;
                                    overflow: elide;
                                    font-size: 11px * Theme.font-scale;
                                    color: Theme.muted;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                                Rectangle {
                                    x: Theme.rtl ? 0px : parent.width - 32px;
                                    y: 8px;
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: pz.has-hover ? Theme.select : Theme.input-bg;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    animate background { duration: 120ms; }
                                    Image {
                                        x: 7px;
                                        y: 7px;
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/pause.svg");
                                        colorize: Theme.text;
                                    }
                                    pz := TouchArea {
                                        clicked => {
                                            root.pause(r.id);
                                        }
                                    }
                                }
                            }
                            if root.active-rows.length == 0: Text {
                                height: 30px;
                                text: @tr("Nothing is downloading right now.");
                                font-size: 12px * Theme.font-scale;
                                color: Theme.muted;
                                vertical-alignment: center;
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            }
                        }
                    }
                    // ---- disk
                    if root.disk-used != "": Card {
                        height: 92px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HRow {
                                Text {
                                    text: @tr("Used") + "  " + root.disk-used;
                                    font-size: 12px * Theme.font-scale;
                                    font-weight: 600;
                                    color: Theme.text;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: @tr("Free") + "  " + root.disk-free;
                                    font-size: 12px * Theme.font-scale;
                                    color: Theme.muted;
                                    horizontal-alignment: right;
                                }
                            }
                            Rectangle {
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.bar-bg;
                                Rectangle {
                                    width: parent.width * clamp(root.disk-frac, 0.0, 1.0);
                                    height: parent.height;
                                    border-radius: 4px;
                                    background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
                                    animate width { duration: 400ms; easing: ease-out; }
                                }
                            }
                        }
                    }
                }
            }

            // ---- status bar
            Rectangle {
                height: 30px;
                background: Theme.window;
                Rectangle {
                    width: parent.width;
                    height: 1px;
                    y: 0;
                    background: Theme.line;
                }
                HRow {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.status-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: 12px * Theme.font-scale;
                        color: Theme.muted;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.limiter-text;
                        vertical-alignment: center;
                        font-size: 11px * Theme.font-scale;
                        color: root.limiter-on ? Theme.warn : Theme.muted;
                    }
                }
            }
        }
    }
    // the note of the toolbar button the mouse rests on (drawn above everything)
    Timer {
        interval: 600ms;
        running: ToolTip.pending;
        triggered => {
            ToolTip.pending = false;
            ToolTip.shown = true;
        }
    }
    if ToolTip.shown && ToolTip.text != "": Rectangle {
        x: min(ToolTip.x, root.width - self.width - 6px);
        y: ToolTip.y;
        width: min(320px, tip-box.preferred-width);
        height: tip-box.preferred-height;
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000044;
        drop-shadow-offset-y: 2px;
        tip-box := VerticalLayout {
            padding: 8px;
            spacing: 3px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: ToolTip.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: ToolTip.text;
                wrap: word-wrap;
                color: Theme.muted;
            }
        }
    }

    // starts the intro animation when the window opens, and measures the window
    Rectangle {
        width: root.width;
        height: 0px;
        init => {
            root.intro = 1.0;
            root.win-w = self.width;
        }
        changed width => {
            root.win-w = self.width;
        }
    }
    // ---- the thin border of the window and its grips to resize it
    Rectangle {
        border-width: 1px;
        border-color: Theme.accent.transparentize(0.65);
        background: transparent;
    }
    if !root.is-max: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        for e[i] in [
            { x: 10px, y: 0px, w: root.width - 20px, h: 4px, dir: 0, cur: 0 },
            { x: 10px, y: root.height - 4px, w: root.width - 20px, h: 4px, dir: 1, cur: 0 },
            { x: root.width - 4px, y: 10px, w: 4px, h: root.height - 20px, dir: 2, cur: 1 },
            { x: 0px, y: 10px, w: 4px, h: root.height - 20px, dir: 3, cur: 1 },
            { x: root.width - 10px, y: 0px, w: 10px, h: 10px, dir: 4, cur: 2 },
            { x: 0px, y: 0px, w: 10px, h: 10px, dir: 5, cur: 3 },
            { x: root.width - 10px, y: root.height - 10px, w: 10px, h: 10px, dir: 6, cur: 3 },
            { x: 0px, y: root.height - 10px, w: 10px, h: 10px, dir: 7, cur: 2 },
        ]: TouchArea {
            x: e.x;
            y: e.y;
            width: e.w;
            height: e.h;
            mouse-cursor: e.cur == 0 ? MouseCursor.ns-resize : e.cur == 1 ? MouseCursor.ew-resize : e.cur == 2 ? MouseCursor.nesw-resize : MouseCursor.nwse-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.win-resize(e.dir);
                }
            }
        }
    }
    // ---- the menu: slides in from the side over a dimmed window
    if root.drawer-t > 0.001: Rectangle {
        width: root.width;
        height: root.height;
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #000000;
            opacity: 0.5 * root.drawer-t;
            TouchArea {
                clicked => {
                    root.drawer-open = false;
                }
            }
        }
        Rectangle {
            width: min(350px, root.width - 40px);
            height: parent.height;
            x: Theme.rtl ? parent.width - self.width + self.width * (1.0 - root.drawer-t) : -self.width * (1.0 - root.drawer-t);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            TouchArea { }
            Flickable {
                width: parent.width;
                height: parent.height;
                content-height: dr.preferred-height;
                dr := VerticalLayout {
                    padding: 14px;
                    spacing: 1px;
                    alignment: start;
                    HRow {
                        spacing: 10px;
                        height: 44px;
                        Image {
                            width: 30px;
                            height: 30px;
                            source: @image-url("icon.png");
                            image-fit: contain;
                        }
                        Text {
                            text: "Badzy";
                            font-size: 22px;
                            font-weight: 800;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }
                    DrawerHead { text: @tr("Tasks"); }
                    DrawerItem { text: @tr("Add new download…") + "   Ctrl+N"; clicked => { root.drawer-open = false; root.add-url(); } }
                    DrawerItem { text: @tr("Add batch download…") + "   Ctrl+B"; clicked => { root.drawer-open = false; root.add-batch(); } }
                    DrawerItem { text: @tr("Add batch download from clipboard"); clicked => { root.drawer-open = false; root.add-batch-clipboard(); } }
                    DrawerItem { text: @tr("Run site grabber…"); clicked => { root.drawer-open = false; root.grabber(); } }
                    DrawerItem { text: @tr("Download a playlist…"); clicked => { root.drawer-open = false; root.playlist(); } }
                    DrawerItem { text: @tr("Add a torrent / magnet link…"); clicked => { root.drawer-open = false; root.torrent(); } }
                    DrawerItem { text: @tr("Open download folder"); clicked => { root.drawer-open = false; root.open-download-folder(); } }
                    DrawerHead { text: @tr("Export"); }
                    DrawerItem { text: @tr("To download list file (.ef2)…"); clicked => { root.drawer-open = false; root.export-list("ef2"); } }
                    DrawerItem { text: @tr("To text file…"); clicked => { root.drawer-open = false; root.export-list("txt"); } }
                    DrawerHead { text: @tr("Import"); }
                    DrawerItem { text: @tr("From download list file (.ef2)…"); clicked => { root.drawer-open = false; root.import-list("ef2"); } }
                    DrawerItem { text: @tr("From text file…"); clicked => { root.drawer-open = false; root.import-list("txt"); } }
                    DrawerHead { text: @tr("File"); }
                    DrawerItem { text: @tr("Download now"); enabled: root.can-resume; clicked => { root.drawer-open = false; root.resume(root.selected-id); } }
                    DrawerItem { text: @tr("Stop download"); enabled: root.can-stop; clicked => { root.drawer-open = false; root.pause(root.selected-id); } }
                    DrawerItem { text: @tr("Remove"); enabled: root.selected-id >= 0; clicked => { root.drawer-open = false; root.delete(root.selected-id); } }
                    DrawerItem { text: @tr("Redownload"); enabled: root.selected-id >= 0; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "restart"); } }
                    DrawerItem { text: @tr("Refresh download address…"); enabled: root.selected-id >= 0 && root.selected-state != 3; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "refresh"); } }
                    DrawerItem { text: @tr("Open"); enabled: root.selected-state == 3; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "open"); } }
                    DrawerItem { text: @tr("Open with…"); enabled: root.selected-state == 3; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "openwith"); } }
                    DrawerItem { text: @tr("Play while downloading"); enabled: root.selected-id >= 0 && root.selected-state != 3; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "preview"); } }
                    DrawerItem { text: @tr("Open folder"); enabled: root.selected-id >= 0; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "folder"); } }
                    DrawerItem { text: @tr("Move / Rename…"); enabled: root.selected-id >= 0; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "move"); } }
                    DrawerItem { text: @tr("Copy address"); enabled: root.selected-id >= 0; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "copy"); } }
                    DrawerItem { text: @tr("Properties"); enabled: root.selected-id >= 0; clicked => { root.drawer-open = false; root.row-action(root.selected-id, "properties"); } }
                    DrawerHead { text: @tr("Downloads"); }
                    DrawerItem { text: @tr("Select all   Ctrl+A"); clicked => { root.drawer-open = false; root.select-all(); } }
                    DrawerItem { text: @tr("Resume all"); clicked => { root.drawer-open = false; root.resume-all(); } }
                    DrawerItem { text: @tr("Stop all"); clicked => { root.drawer-open = false; root.stop-all(); } }
                    DrawerItem { text: @tr("Delete all completed"); clicked => { root.drawer-open = false; root.delete-completed(); } }
                    DrawerItem { text: @tr("Find… Ctrl+F"); clicked => { root.drawer-open = false; root.find(); } }
                    DrawerItem { text: @tr("Find next F3"); clicked => { root.drawer-open = false; root.find-next(); } }
                    DrawerItem { text: @tr("Scheduler…"); clicked => { root.drawer-open = false; root.open-scheduler(); } }
                    DrawerItem { text: @tr("Options…"); clicked => { root.drawer-open = false; root.open-settings(0); } }
                    DrawerHead { text: @tr("Start queue"); }
                    for q in root.queues: DrawerItem { text: q.name; clicked => { root.drawer-open = false; root.start-queue(q.id); } }
                    DrawerHead { text: @tr("Stop queue"); }
                    for q in root.queues: DrawerItem { text: q.name; clicked => { root.drawer-open = false; root.stop-queue(q.id); } }
                    DrawerHead { text: @tr("Speed Limiter"); }
                    DrawerItem { text: (root.limiter-on ? "● " : "○ ") + @tr("Turn on"); clicked => { if (!root.limiter-on) { root.toggle-limiter(); } } }
                    DrawerItem { text: (!root.limiter-on ? "● " : "○ ") + @tr("Turn off"); clicked => { if (root.limiter-on) { root.toggle-limiter(); } } }
                    DrawerItem { text: @tr("Settings…"); clicked => { root.drawer-open = false; root.open-limiter(); } }
                    DrawerHead { text: @tr("When all downloads finish"); }
                    DrawerItem { text: (root.all-done == 0 ? "● " : "○ ") + @tr("Do nothing"); clicked => { root.set-all-done(0); } }
                    DrawerItem { text: (root.all-done == 1 ? "● " : "○ ") + @tr("Shut down the computer"); clicked => { root.set-all-done(1); } }
                    DrawerItem { text: (root.all-done == 2 ? "● " : "○ ") + @tr("Sleep"); clicked => { root.set-all-done(2); } }
                    DrawerItem { text: (root.all-done == 4 ? "● " : "○ ") + @tr("Hibernate"); clicked => { root.set-all-done(4); } }
                    DrawerItem { text: (root.all-done == 3 ? "● " : "○ ") + @tr("Exit Badzy"); clicked => { root.set-all-done(3); } }
                    DrawerHead { text: @tr("View"); }
                    DrawerItem { text: (!root.hide-categories ? "☑ " : "☐ ") + @tr("Show categories"); clicked => { root.toggle-categories(); } }
                    DrawerItem { text: (!root.toolbar-small ? "● " : "○ ") + @tr("Large buttons"); clicked => { root.set-toolbar-small(false); } }
                    DrawerItem { text: (root.toolbar-small ? "● " : "○ ") + @tr("Small buttons"); clicked => { root.set-toolbar-small(true); } }
                    DrawerItem { text: @tr("Columns…"); clicked => { root.drawer-open = false; root.open-columns(); } }
                    DrawerHead { text: @tr("Arrange files"); }
                    for a in [
                        { key: "added", title: @tr("By order of addition") },
                        { key: "name", title: @tr("File name") },
                        { key: "size", title: @tr("Size") },
                        { key: "status", title: @tr("Status") },
                        { key: "eta", title: @tr("Time left") },
                        { key: "speed", title: @tr("Transfer rate") },
                        { key: "date", title: @tr("Last try date") },
                        { key: "desc", title: @tr("Description") },
                        { key: "saveto", title: @tr("Save to") },
                        { key: "referer", title: @tr("Referer") },
                        { key: "parent", title: @tr("Parent web page") }
                    ]: DrawerItem { text: (root.sort-by == a.key ? "● " : "○ ") + a.title; clicked => { root.sort(a.key); } }
                    DrawerHead { text: @tr("Theme"); }
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: start;
                            for i in 9: Rectangle {
                                width: 30px;
                                height: 30px;
                                y: 7px;
                                border-radius: 15px;
                                background: @linear-gradient(135deg, Theme.swatch-bg[i] 0%, Theme.swatch-bg[i] 50%, Theme.swatch-fg[i] 50%, Theme.swatch-fg[i] 100%);
                                border-width: Theme.mode == i ? 3px : 1px;
                                border-color: Theme.mode == i ? Theme.text : Theme.line;
                                transform-scale: sw.has-hover ? 1.15 : 1.0;
                                animate transform-scale { duration: 140ms; easing: ease-out; }
                                animate border-width { duration: 140ms; }
                                sw := TouchArea {
                                    clicked => {
                                        root.set-theme(i);
                                    }
                                }
                            }
                        }
                    }
                    DrawerItem { text: @tr("Appearance…"); clicked => { root.drawer-open = false; root.open-settings(9); } }
                    DrawerHead { text: @tr("Language"); }
                    DrawerItem { text: (root.language == "en" ? "● " : "○ ") + "English"; clicked => { root.set-language("en"); } }
                    DrawerItem { text: (root.language == "ar" ? "● " : "○ ") + "العربية"; clicked => { root.set-language("ar"); } }
                    DrawerItem { text: (root.language == "fr" ? "● " : "○ ") + "Français"; clicked => { root.set-language("fr"); } }
                    DrawerItem { text: (root.language == "es" ? "● " : "○ ") + "Español"; clicked => { root.set-language("es"); } }
                    DrawerItem { text: (root.language == "de" ? "● " : "○ ") + "Deutsch"; clicked => { root.set-language("de"); } }
                    DrawerItem { text: (root.language == "pt" ? "● " : "○ ") + "Português"; clicked => { root.set-language("pt"); } }
                    DrawerItem { text: (root.language == "tr" ? "● " : "○ ") + "Türkçe"; clicked => { root.set-language("tr"); } }
                    DrawerItem { text: (root.language == "ru" ? "● " : "○ ") + "Русский"; clicked => { root.set-language("ru"); } }
                    DrawerHead { text: @tr("Help"); }
                    DrawerItem { text: @tr("Add Badzy to my browser…"); clicked => { root.drawer-open = false; root.browsers(); } }
                    DrawerItem { text: @tr("Tip of the day…"); clicked => { root.drawer-open = false; root.tips(); } }
                    DrawerItem { text: @tr("Check for updates"); clicked => { root.drawer-open = false; root.check-app-update(); } }
                    DrawerItem { text: @tr("Check for updates (video downloader)"); clicked => { root.drawer-open = false; root.update-tools(); } }
                    DrawerItem { text: @tr("About Badzy"); clicked => { root.drawer-open = false; root.about(); } }
                    DrawerItem { text: @tr("Exit"); clicked => { root.drawer-open = false; root.quit(); } }
                }
            }
        }
    }
}
// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download File Info");
    preferred-width: 700px;
    preferred-height: 600px;
    min-width: 540px;
    min-height: 420px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused Badzy: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    // the window's width (decides what is shown)
    in-out property <length> win-w: 700px;
    changed width => {
        root.win-w = self.width;
    }

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    VerticalLayout {
        spacing: 0px;
        Flickable {
            vertical-stretch: 1;
            content-height: form.preferred-height;
            form := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                // ---- URL + check
                HRow {
                    spacing: 8px;
                    Field {
                        label: @tr("URL");
                        horizontal-stretch: 1;
                        LineEdit {
                            icon: @image-url("icons/link.svg");
                            text <=> root.url;
                            placeholder-text: @tr("https://example.com/file");
                            accepted(t) => {
                                root.check-url();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        Button {
                            text: root.probing ? "…" : @tr("Check");
                            enabled: !root.probing;
                            clicked => {
                                root.check-url();
                            }
                        }
                    }
                }
                // ---- status line
                HRow {
                    spacing: 7px;
                    height: 16px;
                    Rectangle {
                        width: 6px;
                        Rectangle {
                            y: 5px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.probing ? Theme.accent : root.info-error ? Theme.err : root.info != "" ? Theme.ok : Theme.muted;
                            opacity: root.probing ? 0.5 + 0.5 * Math.sin(animation-tick() / 1s * 6rad) : 1.0;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.probing ? @tr("Checking the address…") : root.info != "" ? root.info : @tr("Paste a link and press Check");
                        color: root.probing ? Theme.accent : root.info-error ? Theme.err : root.info != "" ? Theme.ok : Theme.muted;
                        font-size: 12px * Theme.font-scale;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    }
                }
                // ---- warning
                if root.warning != "": Rectangle {
                    border-radius: 11px;
                    background: Theme.warn.transparentize(0.88);
                    border-width: 1px;
                    border-color: Theme.warn.transparentize(0.7);
                    height: wtxt.preferred-height + 20px;
                    Image {
                        x: Theme.rtl ? parent.width - 30px : 11px;
                        y: 11px;
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/alert.svg");
                        colorize: Theme.warn;
                    }
                    wtxt := Text {
                        x: Theme.rtl ? 12px : 36px;
                        y: 10px;
                        width: parent.width - 48px;
                        text: root.warning;
                        color: Theme.warn;
                        wrap: word-wrap;
                        font-size: 12px * Theme.font-scale;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    }
                }
                // ---- the file
                if root.size-text != "" || root.ext != "": Rectangle {
                    height: 64px;
                    border-radius: 16px;
                    background: Theme.input-bg;
                    border-width: 1px;
                    border-color: Theme.line;
                    HRow {
                        padding: 10px;
                        spacing: 12px;
                        Image {
                            width: 44px;
                            source: Icons.type(root.kind);
                            image-fit: contain;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.ext != "" ? root.ext + " " + @tr("file") : @tr("File");
                                font-size: 13px * Theme.font-scale;
                                font-weight: 700;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            }
                            Text {
                                text: root.size-text;
                                font-size: 11px * Theme.font-scale;
                                color: Theme.muted;
                                overflow: elide;
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            }
                        }
                    }
                }
                // ---- category + connections
                HRow {
                    spacing: 12px;
                    Field {
                        label: @tr("Category");
                        horizontal-stretch: 1;
                        ComboBox {
                            model: root.category-names;
                            current-index <=> root.category-index;
                            selected(v) => {
                                root.category-changed(root.category-index);
                            }
                        }
                    }
                    Field {
                        label: @tr("Connections") + " (1–32)";
                        horizontal-stretch: 1;
                        SpinBox {
                            minimum: 1;
                            maximum: 32;
                            value <=> root.connections;
                        }
                    }
                }
                // ---- save as
                HRow {
                    spacing: 8px;
                    Field {
                        label: @tr("Save As");
                        horizontal-stretch: 1;
                        LineEdit {
                            text <=> root.save-as;
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        Button {
                            text: @tr("Browse");
                            icon: @image-url("icons/folder.svg");
                            clicked => {
                                root.browse();
                            }
                        }
                    }
                }
                CheckBox {
                    text: @tr("Remember this path for \"{}\" category", root.category-name);
                    checked <=> root.remember-path;
                }
                Field {
                    label: @tr("Description");
                    LineEdit {
                        text <=> root.description;
                        placeholder-text: @tr("optional note");
                    }
                }
                // ---- queue + authorization
                HRow {
                    spacing: 12px;
                    Field {
                        label: @tr("Queue");
                        horizontal-stretch: 1;
                        ComboBox {
                            model: root.queue-names;
                            current-index <=> root.queue-index;
                        }
                    }
                    Field {
                        label: @tr("Use authorization");
                        horizontal-stretch: 1;
                        HRow {
                            height: 36px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    on <=> root.use-login;
                                }
                            }
                        }
                    }
                }
                if root.use-login: Rectangle {
                    border-radius: 11px;
                    background: Theme.input-bg.transparentize(0.4);
                    border-width: 1px;
                    border-color: Theme.line;
                    height: 92px;
                    HRow {
                        padding: 12px;
                        spacing: 12px;
                        Field {
                            label: @tr("Login");
                            horizontal-stretch: 1;
                            LineEdit {
                                icon: @image-url("icons/user.svg");
                                text <=> root.user;
                            }
                        }
                        Field {
                            label: @tr("Password");
                            horizontal-stretch: 1;
                            LineEdit {
                                icon: @image-url("icons/key.svg");
                                text <=> root.password;
                                input-type: InputType.password;
                            }
                        }
                    }
                }
            }
        }
        // ---- footer
        Rectangle {
            height: 58px;
            background: Theme.panel.transparentize(0.4);
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HRow {
                padding: 11px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                Button {
                    text: @tr("Cancel");
                    ghost: true;
                    clicked => {
                        root.cancel();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Download Later");
                    enabled: root.url != "";
                    clicked => {
                        root.later();
                    }
                }
                if root.can-use-browser: Button {
                    text: @tr("Download with the browser");
                    clicked => {
                        root.use-browser();
                    }
                }
                Button {
                    text: @tr("Start Download");
                    icon: @image-url("icons/download.svg");
                    primary: true;
                    enabled: root.url != "";
                    clicked => {
                        root.start-now();
                    }
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 24px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : Theme.window;
    animate background { duration: 160ms; easing: ease-out; }
    border-width: 1px;
    border-color: Theme.line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
    if root.active: Rectangle {
        x: 1px;
        y: parent.height - 1px;
        width: parent.width - 2px;
        height: 2px;
        background: Theme.panel;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 520px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.text;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 12px * Theme.font-scale;
            }
            HRow {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.text;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HRow {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                ComboBox {
                    model: root.queue-names;
                    current-index <=> root.queue-index;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Save all to");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    placeholder-text: @tr("automatic (by file type)");
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// The per-download progress window (tabs like a classic download manager).
export component DetailsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.percent + " " + root.name;
    preferred-width: 560px;
    min-width: 520px;
    // its own title bar (with "hide next to the clock" beside minimize)
    no-frame: true;

    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    in property <int> state;
    in property <[SegView]> segs;
    in-out property <bool> show-details: true;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback hide-to-tray();
    callback limit-changed();
    callback completion-changed();
    // title bar: move the window / minimize / the X
    callback start-drag();
    callback minimize();
    callback close-clicked();
    callback start-resize();
    // "Hide details" / "Show details": the window takes the size it needs
    out property <length> content-height: outer.preferred-height;
    callback details-toggled();

    property <bool> tray-tip;
    tip-timer := Timer {
        interval: 600ms;
        running: tray-btn.hovered && !root.tray-tip;
        triggered => {
            root.tray-tip = true;
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.line;
    }
    outer := VerticalLayout {
      padding: 1px;
      spacing: 0px;
      Rectangle {
        height: 30px;
        background: Theme.panel;
        HRow {
            spacing: 0px;
            Rectangle {
                horizontal-stretch: 1;
                drag := TouchArea {
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                            root.start-drag();
                        }
                    }
                }
                HRow {
                    padding-left: Theme.rtl ? (0px) : (8px);
                    padding-right: Theme.rtl ? (8px) : (0px);
                    spacing: 7px;
                    Rectangle {
                        width: 16px;
                        Image {
                            source: @image-url("icon-window.png");
                            width: 16px;
                            height: 16px;
                            y: 7px;
                        }
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.title;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.text;
                        horizontal-stretch: 1;
                    }
                }
            }
            tray-btn := CaptionButton {
                kind: "tray";
                visible: root.state != 3;
                width: root.state != 3 ? 44px : 0px;
                changed hovered => {
                    if (!self.hovered) {
                        root.tray-tip = false;
                    }
                }
                clicked => {
                    root.tray-tip = false;
                    root.hide-to-tray();
                }
            }
            CaptionButton {
                kind: "min";
                clicked => {
                    root.minimize();
                }
            }
            CaptionButton {
                kind: "close";
                clicked => {
                    root.close-clicked();
                }
            }
        }
      }
      VerticalLayout {
        padding: 10px;
        spacing: 0px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("Download status");
                active: root.tab == 0;
                clicked => {
                    root.tab = 0;
                }
            }
            TabButton {
                text: @tr("Speed Limiter");
                active: root.tab == 1;
                clicked => {
                    root.tab = 1;
                }
            }
            TabButton {
                text: @tr("Options on completion");
                active: root.tab == 2;
                clicked => {
                    root.tab = 2;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            min-height: 176px;
            if root.tab == 0: VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    TypeIcon {
                        kind: root.kind;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        font-size: 11px * Theme.font-scale;
                        overflow: elide;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.grid;
                }
                VerticalLayout {
                    spacing: 3px;
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Status");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.status;
                            color: root.state == 4 ? Theme.err : Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("File size");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.size;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Downloaded");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.downloaded;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Transfer rate");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.speed;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Time left");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.eta;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Resume capability");
                            color: Theme.muted;
                            width: 125px;
                        }
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.resumable;
                            color: root.resumable-ok ? Theme.ok : Theme.err;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if root.error != "": Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 1: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HRow {
                    spacing: 6px;
                    for kb in [128, 256, 512, 1024, 2048, 5120]: Button {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit Badzy"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        Rectangle {
            height: 18px;
            border-width: 1px;
            border-radius: 9px;
            border-color: Theme.line;
            background: Theme.bar-bg;
            clip: true;
            Rectangle {
                x: Theme.rtl ? parent.width - 1px - self.width : 1px;
                y: 1px;
                height: parent.height - 2px;
                width: (parent.width - 2px) * root.progress;
                border-radius: 8px;
                background: @linear-gradient(90deg, #ff3b4a 0%, #ff7a59 100%);
                animate width {
                    duration: 250ms;
                    easing: ease-out;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        HRow {
            spacing: 8px;
            Button {
                text: root.show-details ? @tr("<< Hide details") : @tr("Show details >>");
                clicked => {
                    root.show-details = !root.show-details;
                    root.details-toggled();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.state == 0 || root.state == 1: Button {
                text: @tr("Pause");
                clicked => {
                    root.pause();
                }
            }
            if root.state == 2 || root.state == 4: Button {
                text: @tr("Resume");
                primary: true;
                clicked => {
                    root.resume();
                }
            }
            Button {
                text: root.state == 3 ? @tr("Close") : @tr("Cancel");
                clicked => {
                    if (root.state == 3) {
                        root.close-window();
                    } else {
                        root.cancel-download();
                    }
                }
            }
        }
        if root.show-details: VerticalLayout {
            spacing: 6px;
            padding-top: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Start positions and download progress by connections");
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
            }
            Rectangle {
                height: 20px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                clip: true;
                for s in root.segs: Rectangle {
                    x: Theme.rtl ? parent.width - 1px - (parent.width - 2px) * s.start - self.width : 1px + (parent.width - 2px) * s.start;
                    y: 1px;
                    width: (parent.width - 2px) * (s.done - s.start);
                    height: parent.height - 2px;
                    background: Theme.accent;
                    animate width {
                        duration: 100ms;
                        easing: linear;
                    }
                }
                for s in root.segs: Rectangle {
                    x: Theme.rtl ? parent.width - 2px - (parent.width - 2px) * s.start : 1px + (parent.width - 2px) * s.start;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.err;
                }
            }
            Rectangle {
                height: 150px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 1px;
                    Rectangle {
                        height: 22px;
                        background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                        HRow {
                            HeaderCell {
                                text: @tr("N.");
                                width: 34px;
                            }
                            HeaderCell {
                                text: @tr("Downloaded");
                                width: 110px;
                            }
                            HeaderCell {
                                text: @tr("Info");
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s in root.segs: Rectangle {
                            height: 19px;
                            HRow {
                                Cell {
                                    text: s.number;
                                    width: 34px;
                                    horizontal-alignment: center;
                                }
                                Cell {
                                    text: " " + s.downloaded;
                                    width: 110px;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                                Cell {
                                    text: s.info;
                                    horizontal-stretch: 1;
                                    color: s.busy ? Theme.accent : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    // the hint of the tray button
    if root.tray-tip: Rectangle {
        x: max(4px, root.width - 89px - tip-text.preferred-width - 16px);
        y: 32px;
        width: tip-text.preferred-width + 16px;
        height: tip-text.preferred-height + 10px;
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 3px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000044;
        tip-text := Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Hide next to the clock");
            color: Theme.text;
        }
    }
    // a corner to make the window bigger
    Rectangle {
        x: root.width - 14px;
        y: root.height - 14px;
        width: 14px;
        height: 14px;
        TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.start-resize();
                }
            }
        }
        Path {
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: Theme.muted;
            stroke-width: 1px;
            commands: "M 9 3 L 3 9 M 9 6 L 6 9";
        }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 540px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 16px;
            BigTypeIcon {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: root.kind;
                ext: root.ext;
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Download complete");
                    font-size: 15px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.ok;
                }
                GridLayout {
                    spacing: 6px;
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Address");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        overflow: elide;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.accent;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("File size");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.size;
                        color: Theme.text;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Saved as");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.path;
                        wrap: word-wrap;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.text;
                    }
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Don't show this again");
                checked <=> root.dont-show;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
            // no "Open with…" here: picked by mistake it changes which
            // program opens this kind of file (still in the list's menu)
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
